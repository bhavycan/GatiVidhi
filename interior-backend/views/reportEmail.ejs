<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Tanika Associate</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body, table, td, a {
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }
    table {
      border-collapse: collapse !important;
    }
    img {
      border: 0;
      height: auto;
      line-height: 100%;
      outline: none;
      text-decoration: none;
    }

    #name{
        font-size: 2em;
        font-family: cursive;
    }

    .email-wrapper {
      width: 100%;
      background-color: #f5f7fa;
      padding: 0 16px;
    }
    .email-content {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 8px;
      overflow: hidden;
      font-family: Arial, Helvetica, sans-serif;
    }

    .email-header {
      background-color: #202a44;
      color: #ffffff;
      padding: 24px 32px;
      text-align: center;
    }
    .email-header h1 {
      margin: 0;
      font-size: 22px;
    }

    .email-body {
      padding: 24px 32px;
      color: #374151;
      font-size: 16px;
    }

    .contant{
      line-height: 0;

    }

     .contant a{
      text-decoration: none;
    
      
    }

    .cta-button {
      display: inline-block;
      margin-top: 24px;
      padding: 12px 24px;
      background-color: #202a44;
      color: #ffffff !important;
      text-decoration: none;
      border-radius: 4px;
      font-size: 14px;
    }

    .email-footer {
      padding: 16px 32px;
      text-align: center;
      font-size: 12px;
      color: #9ca3af;
    }

    @media screen and (max-width: 640px) {
      .email-body {
        padding: 16px 24px;
      }
      .email-header {
        padding: 16px 24px;
      }
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#f5f7fa;">
  <div class="email-wrapper">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" width="100%" class="email-content">
      <tr>
        <td class="email-header">
          <h1>Tanika Associate</h1>
        </td>
      </tr>
      <tr>
        <td class="email-body">
          <p id="name">Hello <%= user.name %>!</p>
          <p>Hope this email finds you well.</p>
          <p>Your report for <strong><%= user.date %></strong> is now available. You can access the full report by clicking the button below:</p>
          <a href="<%= user.url %>" class="cta-button">View Report</a>
          <p>If you have any further request or query, please reach out to us. Have a good one!</p>

          <div class="contant">
            <h5>Email: <a href="mailto:bhavy203@gmail.com">bhavy203@gmail.com</a></h5>
            <h5>Phone: <a href="tel:+12342342345">12342342345</a></h5>
            <h5>Address: 123 Business Rd, Business City, BC 12345</h5>
          </div>
        </td>
      </tr>
      <tr>
        <td class="email-footer">
          &copy; 2023 Your Company. All rights reserved.<br />
          123 Business Rd, Business City, BC 12345
        </td>
      </tr>
    </table>
  </div>
</body>
</html>

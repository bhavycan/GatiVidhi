<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Tanika Associate – Approval Required</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table { border-collapse: collapse !important; }
    img { border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }

    #name { font-size: 2em; font-family: cursive; }

    .email-wrapper { width: 100%; background-color: #f5f7fa; padding: 0 16px; }
    .email-content {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 8px;
      overflow: hidden;
      font-family: Arial, Helvetica, sans-serif;
    }
    .email-header {
      background-color: #883bbc;
      color: #ffffff;
      padding: 24px 32px;
      text-align: center;
    }
    .email-header h1 { margin: 0; font-size: 22px; }
    .email-header p { margin: 6px 0 0; font-size: 13px; opacity: 0.85; }

    .email-body { padding: 24px 32px; color: #374151; font-size: 16px; }

    .info-box {
      background-color: #faf5ff;
      border-left: 4px solid #883bbc;
      border-radius: 4px;
      padding: 16px 20px;
      margin: 20px 0;
    }
    .info-box p { margin: 6px 0; font-size: 14px; }
    .info-box .label { font-weight: bold; color: #883bbc; }

    .priority-badge {
      display: inline-block;
      padding: 3px 12px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: bold;
      text-transform: capitalize;
    }
    .priority-high   { background-color: #fee2e2; color: #b91c1c; }
    .priority-medium { background-color: #fef3c7; color: #92400e; }
    .priority-low    { background-color: #dcfce7; color: #166534; }

    .contant { line-height: 0; }
    .contant a { text-decoration: none; }

    .email-footer { padding: 16px 32px; text-align: center; font-size: 12px; color: #9ca3af; }

    @media screen and (max-width: 640px) {
      .email-body  { padding: 16px 20px; }
      .email-header { padding: 16px 20px; }
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#f5f7fa;">
  <div class="email-wrapper">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" width="100%" class="email-content">

      <tr>
        <td class="email-header">
          <h1>Tanika Associate</h1>
          <p>Client Approval Required</p>
        </td>
      </tr>

      <tr>
        <td class="email-body">
          <p id="name">Hello <%= user.name %>!</p>

          <p>Your approval is needed for an item on your project <strong><%= user.projectName %></strong>. Please review the details below and let us know your decision.</p>

          <div class="info-box">
            <p><span class="label">Title:</span> <%= user.title %></p>
            <p><span class="label">Date:</span> <%= user.date %></p>
            <p>
              <span class="label">Priority:</span>
              <span class="priority-badge priority-<%= user.priority %>"><%= user.priority %></span>
            </p>
            <% if (user.note && user.note.length > 0) { %>
            <p><span class="label">Note:</span> <%= user.note %></p>
            <% } %>
          </div>

          <p>Please contact us or log in to your project portal to approve or discuss this item.</p>

          <p>If you have any questions, feel free to reach out to us directly.</p>

          <div class="contant">
            <h5>Email: <a href="mailto:bhavy203@gmail.com">bhavy203@gmail.com</a></h5>
            <h5>Phone: <a href="tel:+12342342345">12342342345</a></h5>
            <h5>Address: 123 Business Rd, Business City, BC 12345</h5>
          </div>
        </td>
      </tr>

      <tr>
        <td class="email-footer">
          &copy; 2023 Tanika Associate. All rights reserved.<br />
          123 Business Rd, Business City, BC 12345
        </td>
      </tr>

    </table>
  </div>
</body>
</html>
